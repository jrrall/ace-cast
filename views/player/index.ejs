<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/brand/favicon-32.png">
    <link rel="apple-touch-icon" href="/images/brand/apple-touch-icon.png">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/theme.css">
    <link rel="stylesheet" href="/css/cards.css">
    <link rel="stylesheet" href="/css/player.css">
</head>
<body>
    <div class="container">
        <header>
            <button id="sound-toggle" class="sound-toggle" type="button" aria-pressed="false" aria-label="Mute sound">🔊</button>
            <h1 class="wordmark"><img class="brand-logo" src="/images/brand/omfg-logo.png" alt="omfg.cards" width="870" height="290"></h1>
            <div id="room-info" style="display: none;">
                <span class="room-code">Room: <span id="current-room-code"></span></span>
            </div>
        </header>

        <main>
            <div id="join-screen" class="screen active">
                <div class="join-card">
                    <p class="eyebrow">You’re invited</p>
                    <h2>Take a seat.</h2>
                    <p class="join-description">Good company. Terrible answers.</p>
                    <form id="join-form">
                        <div class="form-group">
                            <label for="player-name">Your name</label>
                            <input type="text" id="player-name" placeholder="What should we call you?" autocomplete="nickname" maxlength="30" required>
                        </div>
                        <div class="form-group">
                            <label for="room-code-input">Room code</label>
                            <input type="text" id="room-code-input" placeholder="ABCD" maxlength="4" autocapitalize="characters" spellcheck="false" value="<%= roomCode %>" required>
                        </div>
                        <button type="submit" class="primary-btn">Join Game</button>
                    </form>
                </div>
            </div>

            <div id="lobby-screen" class="screen">
                <div class="lobby-info">
                    <h2>You’re at the table.</h2>
                    <p id="player-status" role="status">Waiting for the rest of your crew…</p>
                    <p class="lobby-guidance">Invite a friend with the room code above. With 2 people, bots fill the table and the game starts automatically unless the host pauses it.</p>
                    
                    <details class="how-to-play" open>
                        <summary>How to play</summary>
                        <ol><li>Read the prompt. Tap your funniest answer to play it.</li><li>The judge (Card Czar) picks their favorite. The winner gets a point.</li><li>Take turns judging. The round bar shows the score to beat.</li></ol>
                    </details>
                    <div class="players-section">
                        <h3>At the table (<span id="player-count">0</span>)</h3>
                        <ul id="players-list"></ul>
                    </div>
                </div>
            </div>

            <div id="game-screen" class="screen">
                <div class="game-info">
                    <h3 id="game-type-display">Game Type</h3>
                    <div id="game-status" class="game-status"></div>
                </div>

                <div class="game-content">
                    <div id="game-message" class="game-message">
                        Welcome to the game!
                    </div>

                    <div id="player-area" class="player-area">
                        <!-- Player-specific content will be dynamically added here -->
                    </div>

                    <div id="game-actions" class="game-actions">
                        <!-- Available actions will be dynamically added here -->
                    </div>
                </div>

                <div class="scoreboard">
                    <h4>Scores</h4>
                    <div id="scores-list"></div>
                </div>
            </div>

            <div id="error-screen" class="screen">
                <div class="error-card">
                    <h2>Oops!</h2>
                    <p id="error-message">Something went wrong.</p>
                    <button id="retry-btn" class="primary-btn">Try Again</button>
                </div>
            </div>
        </main>

        <div class="connection-status" id="connection-status">
            <span class="status-indicator"></span>
            <span class="status-text">Connecting...</span>
        </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/card-render.js"></script>
    <script src="/js/sound.js"></script>
    <script src="/js/player.js"></script>
</body>
</html>