<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/brand/favicon-32.png">
    <link rel="apple-touch-icon" href="/images/brand/apple-touch-icon.png">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/theme.css">
    <link rel="stylesheet" href="/css/host.css">
</head>
<body>
    <div class="container">
        <header>
            <h1 class="wordmark"><img class="brand-logo" src="/images/brand/omfg-logo.png" alt="omfg.cards" width="870" height="290"></h1>
            <p>Good company. Terrible answers.</p>
        </header>

        <main>
            <div id="setup-screen" class="screen active">
                <div class="setup-card">
                    <p class="eyebrow">Your next questionable game night</p>
                    <h2>Great friends.<br>Awful answers.</h2>
                    <p class="setup-description">A fill-in-the-blank party game. Play the funniest answer from your hand and let your friends be the judge.</p>
                    <button id="create-room-btn" class="primary-btn">Create a game →</button>
                    <p class="help-text">2+ people · Phones only · TV optional</p>
                    <a class="join-existing" href="/player">Have a room code? Join a game</a>
                </div>
            </div>

            <div id="room-screen" class="screen">
                <div class="room-info">
                    <p class="eyebrow">Your table is ready</p>
                    <h2>Let’s get you playing.</h2>
                    <p class="room-next-step">Join on this phone, then invite a friend with the code or QR.</p>
                    <div class="room-code-display">
                        <span class="label">Room code</span>
                        <span id="room-code" class="room-code"></span>
                    </div>
                    
                    <div class="qr-section">
                        <h3>Scan to take a seat</h3>
                        <div id="qr-code-container"></div>
                        <a id="join-play-link" href="#" class="play-link">Join &amp; play →</a>
                        <p class="join-url">Or visit: <a id="join-url" href="#"></a></p>
                    </div>

                    <div class="tv-section">
                        <h3>Make it a big-screen night</h3>
                        <a id="tv-url" href="#" target="_blank" rel="noopener" class="tv-link">Open TV Display</a>
                        <p class="help-text">Optional: open the display on your TV browser.</p>
                    </div>
                </div>

                <div class="players-section">
                    <h3>At the table (<span id="player-count">0</span>)</h3>
                    <div class="bot-controls">
                        <button id="remove-bot-btn" disabled class="secondary-btn" type="button">− Bot</button>
                        <span id="bot-hint" class="help-text">Join with 2 people to add bots. People take turns judging.</span>
                        <button id="add-bot-btn" disabled class="secondary-btn" type="button">+ Bot</button>
                    </div>
                    <ul id="players-list"></ul>
                </div>

                <div class="game-controls">
                    <h3>Ready when you are</h3>
                    <p class="help-text">The game starts automatically when the table is ready. With 2 people, bots fill the extra seats.</p>
                    <p class="help-text" id="countdown-status"></p>
                    <div class="start-controls">
                        <button id="start-game-btn" class="primary-btn" disabled>Start now</button>
                        <button id="autostart-toggle-btn" class="secondary-btn" type="button">Pause auto-start</button>
                    </div>
                    <button id="end-game-btn" class="secondary-btn" style="display: none;">End Game</button>
                </div>

                <div class="game-status">
                    <h3>Table status</h3>
                    <div id="game-status-content">
                        <p>Join the game yourself, then invite a friend.</p>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/host.js"></script>
</body>
</html>