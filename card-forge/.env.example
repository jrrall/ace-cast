# --- Card Forge configuration -------------------------------------------------
# Copy to `.env` and fill in. Never commit the real `.env`.

# LLM gateway (OpenAI-compatible litellm; calls POST {LLM_BASE_URL}/v1/chat/completions)
LLM_BASE_URL=https://llm.otix.ai
LLM_API_KEY=changeme
LLM_MODEL=gpt-4o-mini
# Reasoning models think before answering; cold model-loads need even longer.
# LLM_TIMEOUT=180

# ace-cast content API. The agent talks to the game ONLY over this HTTP API.
# CONTENT_API_TOKEN should be a per-agent SERVICE TOKEN minted on the game side:
#   npm run token:create -- --client card-forge-prod
# It is shown once, starts with `ct_live_`, and can be revoked on its own
# (`npm run token:revoke -- --client card-forge-prod`) without disturbing any
# other client. The game's legacy shared CONTENT_API_TOKEN also still works.
CONTENT_API_URL=https://unholy.cards
CONTENT_API_TOKEN=changeme
# CONTENT_API_TIMEOUT=30

# Target pack + maturity ceiling (must match the server pack's maturity_max).
# PACK_SLUG=madlad-generated
# MATURITY_MAX=2

# Batch sizing (a human reviews ~10-20/day).
# BATCH_MIN=10
# BATCH_MAX=20
# THEMES_PER_RUN=4
# CARDS_PER_THEME=8

# Trendscout source ALLOWLIST (comma-separated). ONLY these URLs are fetched.
# Feed content is treated as untrusted DATA, never instructions.
# You are responsible for each source's Terms of Service and legality.
# FEED_ALLOWLIST=https://www.reddit.com/r/memes/top.json?t=day&limit=25,https://feeds.bbci.co.uk/news/rss.xml
# FEED_USER_AGENT=card-forge/0.1 (+https://unholy.cards)
# FEED_TIMEOUT=20

# Content-policy deny-list (comma-separated, case-insensitive substrings).
# Defence-in-depth on top of the server's authoritative deny-list. Tune it.
# DENY_LIST=kys,kill yourself,slur
