# --- Card Forge configuration -------------------------------------------------
# Copy to `.env` and fill in. Never commit the real `.env`.

# OpenAI-compatible endpoint. Both a server root and a /v1 base URL work.
# Local Ollama ignores the API key. Choose a model from `ollama list`.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=huihui_ai/qwen3-abliterated:8b
# Per-request timeout; tune to the server/model. SDK retries are off by default.
# LLM_TIMEOUT=115
# LLM_MAX_RETRIES=0
# Retry a timeout once after 2 seconds (0 disables). Not layered on SDK retries.
# LLM_TIMEOUT_RETRIES=1
# Separate bounded retries for invalid/truncated model JSON (0 disables).
# LLM_JSON_RETRIES=1
# Omitted by default. For Ollama thinking models, "none" disables thinking.
# Only set this if your server and model support the parameter.
# LLM_REASONING_EFFORT=none

# ace-cast content API. The agent talks to the game ONLY over this HTTP API.
# CONTENT_API_TOKEN should be a per-agent SERVICE TOKEN minted on the game side:
#   npm run token:create -- --client card-forge-prod
# It is shown once, starts with `ct_live_`, and can be revoked on its own
# (`npm run token:revoke -- --client card-forge-prod`) without disturbing any
# other client. The game's legacy shared CONTENT_API_TOKEN also still works.
CONTENT_API_URL=https://unholy.cards
CONTENT_API_TOKEN=changeme
# CONTENT_API_TIMEOUT=30

# Target pack + generator maturity ceiling (independent of pack metadata).
# PACK_SLUG=madlad-generated
# MATURITY_MAX=3

# Maximum pending cards per run (1-50, matching the default API request limit).
# Lower this to reduce review volume; use multiple runs to accumulate 100/day.
# No minimum is enforced; the cap does not generate extra candidates.
# BATCH_MAX=50
# Cards per editor call (1-50); lower for slow local models.
# EDITOR_BATCH_SIZE=12
# Independent moderation verdicts per call; scored cards per curator call.
# MODERATOR_BATCH_SIZE=12
# CURATOR_BATCH_SIZE=8
# THEMES_PER_RUN=4
# Total cards per theme, split across the selected writers (minimum 8 for all eight; 16 gives each a prompt and answer).
# CARDS_PER_THEME=8

# Trendscout source ALLOWLIST (comma-separated). ONLY these URLs are fetched.
# Feed content is treated as untrusted DATA, never instructions.
# You are responsible for each source's Terms of Service and legality.
# Reddit is NOT a usable source: it returns an HTML interstitial (403) to any
# unauthenticated client on .json and .rss alike, whatever User-Agent you send.
# Only a signed-in browser gets data. Their OAuth API is the supported route.
# Defaults cover memes, world news, US news, technology, internet culture, and relationships.
# Set this only to REPLACE the default source list.
# FEED_ALLOWLIST=https://knowyourmeme.com/newsfeed.rss,https://feeds.bbci.co.uk/news/rss.xml,https://www.theguardian.com/world/rss,https://feeds.npr.org/1001/rss.xml,https://arstechnica.com/feed/,https://www.404media.co/rss/,https://www.theguardian.com/lifeandstyle/rss,https://www.loc.gov/collections/today-in-history/?fo=json,https://weeklyworldnews.com/archive/,https://b3ta.com/questions/imagechallenge/,https://archive.org/wayback/available?url=infowars.com
# FEED_USER_AGENT=card-forge/0.1 (+https://unholy.cards)
# FEED_TIMEOUT=20

# Content-policy deny-list (comma-separated, case-insensitive substrings).
# Defence-in-depth on top of the server's authoritative deny-list. Tune it.
# DENY_LIST=kys,kill yourself,slur

# Fictional everyday + off-the-cuff research seeds per lane (0 disables; max 8).
# INSPIRATION_PER_LANE=3

# Share of writing themes reserved for fictional tabloid inspiration (0-100).
# 25 = one of four themes; a one-theme run chooses it with 25% probability.
# TABLOID_PERCENT=25

# Weighted curator quality cutoff, 0-100; default 70.
# Playability and duplicate checks also apply.
# QUALITY_MIN=70
# QUALITY_WEIGHTS={"playability":0.30,"comic_turn":0.25,"specificity":0.15,"economy":0.10,"originality":0.20}

# Opt into one paired comedy challenge/revision round before editing.
# COMEDY_LOOP=false
# Optional append-only JSONL trace; mount its parent directory in Docker.
# COMEDY_TRACE_PATH=/output/comedy.jsonl

# Max short b3ta finds admitted for review (0 disables).
# SOURCE_FINDS_MAX=6

# Optional directory replacing bundled persona TOMLs. Docker: mount and set /personas.
PERSONAS_DIR=
# 0 = all enabled personas; e.g. 6 = random six, frozen in the run checkpoint.
WRITERS_PER_RUN=0
# Each selected persona scouts the same source pool independently before writing.
# false retains the old shared-theme route. Checkpoints preserve their run mode.
PERSONA_SCOUT=true
# Bounded JSON scouting excerpts; full originals remain in research.json.
SCOUT_EXCERPT_CHARS=800

# Stories per persona scout call; one theme or null per batch.
SCOUT_BATCH_SIZE=6
